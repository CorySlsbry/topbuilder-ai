# =============================================================================
# Top Builder AI — Environment Variables (template)
# =============================================================================
# Copy this file to apps/web/.env.local for local dev.
# For production, store sensitive values in Google Secret Manager and reference
# them in Cloud Run via --set-secrets. See docs/DEPLOYMENT.md.
# =============================================================================

# -----------------------------------------------------------------------------
# Public (safe to expose in browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_EMULATORS=1            # set to 0 in production
NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# GCP / Cloud Run
# -----------------------------------------------------------------------------
GCP_PROJECT=builder-ai-497610
GCP_LOCATION=us-central1
# KMS key for envelope encryption of OAuth tokens
KMS_KEY_NAME=projects/builder-ai-497610/locations/us-central1/keyRings/topbuilder/cryptoKeys/token-encryption-key
# Service account for Cloud Tasks → Cloud Run OIDC verification
WORKER_SERVICE_ACCOUNT_EMAIL=person1@example.com
# Cloud Tasks queue names
CT_QUEUE_WEBHOOK=webhook-processor
CT_QUEUE_AGENT_RUNS=agent-runs
CT_QUEUE_PROCORE_SYNC=procore-sync
CT_QUEUE_QBO_SYNC=qbo-sync

# -----------------------------------------------------------------------------
# Firebase Admin SDK
# -----------------------------------------------------------------------------
# In production, omit these — use Application Default Credentials via the
# service account attached to Cloud Run. These values are only for local dev
# when you need to talk to a real Firebase project (not emulators).
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Procore (Embedded App — per-user OAuth)
# -----------------------------------------------------------------------------
# Register your Embedded App at https://developers.procore.com/developers
# Configuration → OAuth redirect URI must include
#   http://localhost:3000/api/oauth/procore/callback (dev)
#   https://topbuilderai.com/api/oauth/procore/callback (prod)
PROCORE_API_BASE_URL=https://api.procore.com
PROCORE_LOGIN_URL=https://login.procore.com
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=                       # secret — Secret Manager in prod
PROCORE_WEBHOOK_SECRET=                      # secret — for HMAC verification
PROCORE_DEFAULT_SCOPES=

# -----------------------------------------------------------------------------
# QuickBooks Online
# -----------------------------------------------------------------------------
QBO_ENVIRONMENT=sandbox                      # sandbox | production
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=                           # secret
QBO_WEBHOOK_VERIFIER_TOKEN=                  # secret

# -----------------------------------------------------------------------------
# Anthropic Claude
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=                           # secret
# Latest model IDs — update via env var, never hardcode in source
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
ANTHROPIC_MODEL_COMPLEX=claude-opus-4-7
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
# Platform support agent. 404s fall back to ANTHROPIC_MODEL_DEFAULT at call time.
ANTHROPIC_MODEL_SUPPORT=claude-sonnet-4-7

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=                           # secret
STRIPE_WEBHOOK_SECRET=                       # secret
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE_PLACEHOLDER=         # contact-sales tier

# -----------------------------------------------------------------------------
# Resend (transactional email)
# -----------------------------------------------------------------------------
RESEND_API_KEY=                              # secret
RESEND_FROM_EMAIL=Top Builder AI <noreply@topbuilderai.com>

# -----------------------------------------------------------------------------
# Platform console + support + CAN-SPAM
# -----------------------------------------------------------------------------
# /platform is gated to the hardcoded allowlist in lib/platform/auth.ts. This var
# adds EXTRA platform admins; delimit with space/pipe/semicolon, NEVER comma
# (cloudbuild --set-env-vars is comma-delimited).
PLATFORM_ADMIN_EMAILS=
# Where platform support replies + lead/issue notifications are sent.
FOUNDER_NOTIFICATION_EMAIL=cory@salisburybookkeeping.com
# HMAC key for one-click unsubscribe links (server-only). Generate 32 random bytes.
EMAIL_UNSUBSCRIBE_SECRET=
# CAN-SPAM footer identity. COMPANY_POSTAL_ADDRESS MUST be a real registered
# address before sending commercial email. It contains commas, so it CANNOT go
# in cloudbuild --set-env-vars — set it as a Cloud Run env var (console) or edit
# the default in lib/email/send.ts.
COMPANY_NAME=Top Builder AI — Salisbury Bookkeeping LLC
COMPANY_POSTAL_ADDRESS=

# -----------------------------------------------------------------------------
# Rate limiting (Upstash Redis or Memorystore)
# -----------------------------------------------------------------------------
# Optional in dev. Falls back to in-memory limiter if not provided.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Sentry
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
